# Data. The raw 1.7 GB download stays out; the processed table goes in, because
# committing it is what lets the app deploy and lets anyone clone and run this
# without the download. Eleven files, ~8 MB each.
data/raw/
*.csv
!tests/fixtures/*.csv
!data/processed/flights/**/*.parquet
# The two-year table is for model training and is rebuildable from the fetch
# scripts, so it stays out. The raw downloads too.
data/processed/flights_full/
# but the trained model IS committed -- the deployed application loads it and
# cannot retrain on a free tier
!data/processed/model/
data/raw/bts/
data/raw/isd/
data/raw/weather/
# A 300-row sample IS committed: it documents the schema and lets anyone
# inspect the columns without the 1.6 GB download.
!data/raw/sample_rows_2024.csv

# Secrets
.env

# Private planning docs — local only, never committed
docs/

# Python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# AI context
CLAUDE.md

# Cached LLM parses -- avoids re-spending the free-tier daily quota
.cache/

# Slide deck -- regenerate rather than version a 1.7 MB binary
challenge3_ai_design.pptx

# macOS
.DS_Store

# Co-Design app: traveller feedback written at runtime
results/codesign/feedback.jsonl
